{
  "bin_dir": "~/.local/bin",
  "tools": {
    "lazygit": {
      "repo": "jesseduffield/lazygit",
      "asset": "lazygit_{version}_linux_{arch}.tar.gz",
      "extract": "lazygit"
    },
    "lazydocker": {
      "repo": "jesseduffield/lazydocker",
      "asset": "lazydocker_{version}_Linux_{arch}.tar.gz",
      "extract": "lazydocker"
    },
    "lazypodman": {
      "repo": "m7medVision/lazypodman",
      "asset": "lazypodman_{version}_Linux_{arch}.tar.gz",
      "extract": "lazypodman"
    },
    "helm": {
      "repo": "helm/helm",
      "url": "https://get.helm.sh/helm-v{version}-linux-{arch}.tar.gz",
      "extract": "linux-{arch}/helm"
    },
    "lfk": {
      "repo": "janosmiko/lfk",
      "asset": "lfk_{version}_linux_{arch}.tar.gz",
      "extract": "lfk"
    },
    "sofka": {
      "repo": "nklmilojevic/sofka",
      "asset": "sofka-v{version}-{arch}-unknown-linux-gnu.tar.gz",
      "extract": "sofka"
    },
    "fzf": {
      "repo": "junegunn/fzf",
      "asset": "fzf-{version}-linux_{arch}.tar.gz",
      "extract": "fzf"
    },
    "fd": {
      "repo": "sharkdp/fd",
      "asset": "fd-v{version}-{arch}-unknown-linux-gnu.tar.gz",
      "extract": "fd-v{version}-{arch}-unknown-linux-gnu/fd"
    },
    "rg": {
      "repo": "BurntSushi/ripgrep",
      "asset": "ripgrep-{version}-{arch}-unknown-linux-musl.tar.gz",
      "extract": "ripgrep-{version}-{arch}-unknown-linux-musl/rg"
    },
    "yq": {
      "repo": "mikefarah/yq",
      "asset": "yq_linux_{arch}"
    },
    "dtop": {
      "repo": "amir20/dtop",
      "asset": "dtop-{arch}-unknown-linux-gnu.tar.gz",
      "extract": "dtop-{arch}-unknown-linux-gnu/dtop"
    }
  }
}
